# required for initializing commercetools checkout using session API
VITE_CTP_APPLICATION_KEY=[your-application-key, you get it in merchant center when you create payment only checkout application]
VITE_CTP_FULL_APPLICATION_KEY=[your-full-checkout-application-key, you get it in merchant center when you create a full checkout application]
VITE_CTP_PROJECT_KEY=[your-project-key]
VITE_CTP_REGION=[your project region, i.e. europe-west1.gcp]

#Not needed for the Enabler, but needed for the demo to work
#WARNING: this client secret is compiled directly into the browser bundle (Vite inlines all VITE_-prefixed
#vars at build time). Never point this at a production commercetools project — use a disposable/sandboxed
#project scoped to only what this demo needs (see the scope list below).
VITE_CTP_CLIENT_ID=[your-client-id]
VITE_CTP_CLIENT_SECRET=[your-client-secret]
VITE_CTP_SCOPE=manage_orders:braintree-dev view_products:braintree-dev view_shipping_methods:braintree-dev view_discount_codes:braintree-dev manage_sessions:braintree-dev
